{
  "compilerOptions": {
    /* Environment & Module Options */
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* File Layout */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Output Customizations */
    "sourceMap": true,
    "declaration": false,

    /* Strict Typechecking */
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
